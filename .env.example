# ---------- Auth (required) ----------
# Any long random string. Generate one with:  npx auth secret   or   openssl rand -base64 32
NEXTAUTH_SECRET=
# Where the app runs: http://localhost:3000 locally, your live domain on Vercel
# (e.g. https://tembea254-project.vercel.app). No spaces around the "=".
NEXTAUTH_URL=http://localhost:3000

# ---------- Database for accounts & posts (REQUIRED on Vercel) ----------
# Vercel's file system is read-only, so email sign-up, community posts, reviews and bookings
# need a database there. Vercel → your project → Storage → Create → "Upstash for Redis" (free)
# → Connect to project. That adds these two automatically. Locally you can leave them empty
# and data is kept in .data/*.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Continue with Google ----------
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised redirect URIs (add both):
#   http://localhost:3000/api/auth/callback/google
#   https://tembea254-project.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Continue with Facebook ----------
# developers.facebook.com > My Apps > Create app > Facebook Login
# Valid OAuth redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Show the "Explore with a demo account" link in the sign-in modal (set to false for production)
NEXT_PUBLIC_DEMO_LOGIN=true

# ---------- Optional: AI drafting ----------
# Without a key the built-in Kenya planning engine is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Testimonials ----------
# Sample reviews are shown in development only. Set to false to hide them locally too.
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=true

# ---------- Optional: M-Pesa (Safaricom Daraja, Lipa na M-Pesa Online) ----------
# developer.safaricom.co.ke > My Apps. Without these, marketplace checkout runs in demo mode (no money moves).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public HTTPS URL (use ngrok or your deployed domain): https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=
